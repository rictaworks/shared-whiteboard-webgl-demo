# --- Secrets（最優先・コミット事故の再発防止） ---
.env
.env.*
!.env.example
config/master.key
**/config/master.key
**/config/credentials/*.key
*.pem
*.key
!*.pub.key

# --- .claude/ の扱いはリポジトリの公開設定で決める ---
# PUBLICリポジトリ：以下を有効化し、.claude/を丸ごと除外する（社内ノウハウの公開防止。questboardで実施済み）
.claude/*
#
# PRIVATEリポジトリ：上の行をコメントアウトし、.claude/を丸ごとコミットする
# （露出リスクが無く、クローン直後からsettings.json・agents・workflowsが動く。x-follower-gateで実施済み）

# --- ノウハウ・非公開ディレクトリ（公開/非公開に関わらず常に除外） ---
CLIENT/
DEBUG/
TASKS/
WORK/
DELETE/
ENV/

# --- Rails ---
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
.byebug_history
/public/assets

# --- Rails（src/backend。ルート直下ではなくネストしているため非アンカーで指定） ---
src/backend/vendor/bundle/
# WSL側でbundle installした際の副産物（reviewerがWSLネイティブfsでテスト実行するために作成）。
# Windows側リポジトリには不要（2026-09-18追記）。
src/backend/vendor/bundle_wsl/
src/backend/.bundle/
src/backend/db/*.sqlite3
src/backend/db/*.sqlite3-*
src/backend/log/*
src/backend/tmp/*
!src/backend/log/.keep
!src/backend/tmp/.keep

# 注意：上の「ノウハウ・非公開ディレクトリ」節の TASKS/ は非アンカーかつ
# このファイルシステムでは大文字小文字を区別しないため、Rails標準の lib/tasks/
# （rake task配置場所）まで意図せず無視してしまう。既存行は変更せず、
# 追加の否定パターンでこのパスだけ復元する。
!src/backend/lib/tasks/
!src/backend/lib/tasks/*.rake

# --- Node / Next.js / Vercel ---
node_modules/
.next/
out/
.vercel

# --- Python / FastAPI ---
__pycache__/
*.pyc
.venv/
venv/

# --- Go ---
/bin/

# --- Rust / Tauri ---
target/
src-tauri/target/

# --- Unity ---
/Library/
/Temp/
/Obj/
/Build/
/Logs/
/UserSettings/
/MemoryCaptures/
*.csproj
*.sln

# --- Playwright ---
test-results/
playwright-report/
/.playwright-mcp/

# --- エディタ・OS ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*Zone.Identifier

# --- テスト・カバレッジ ---
coverage/
.rspec_status
