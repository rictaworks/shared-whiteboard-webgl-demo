# このファイルをコピーして .env を作成してください（.env はコミットされません）。
# 3層（Rails / Go中継 / Unity WebGLビルド）が共通で参照する値です。

# --- 共通 ---
# Go中継とRailsアプリケーション間の内部API認証に使う共有シークレット。
# 十分な長さのランダム文字列を設定してください（例: `openssl rand -hex 32`）。
INTERNAL_SHARED_SECRET=

# フロントエンドの配信元として許可するOrigin（カンマ区切り）。
# 開発時はローカルのUnity実行元・簡易HTTPサーバーのOriginを指定する。
# 本番はUnity Playの配信元のみを指定する（デプロイ時に確定）。
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# --- Rails アプリケーション層（src/backend） ---
RAILS_ENV=development
# Go中継サーバーの内部エンドポイントURL（日次リセット時のハブ破棄要求に使用）
RELAY_INTERNAL_URL=http://localhost:8081

# --- Go 中継サーバー（src/relay） ---
# Railsアプリケーション層の内部エンドポイントURL
APP_INTERNAL_URL=http://localhost:3001
# 中継サーバー自体のHTTP/WebSocket待受ポート（内部エンドポイント /internal/reset 等も同ポートで提供する）
PORT=8080
# バインドするインターフェース。空（既定）は全インターフェース（Railway等の本番向け）。
# ローカルWindowsでの開発・テスト時はWindowsファイアーウォールの許可ダイアログを避けるため
# 127.0.0.1（ループバック限定）を指定する。
RELAY_HOST=127.0.0.1
